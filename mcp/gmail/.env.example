# OAuth Desktop files. Both paths are local and ignored by Git.
AEGISVAULT_GMAIL_CREDENTIALS_PATH=credentials.json
AEGISVAULT_GMAIL_TOKEN_PATH=token.json

# Comma-separated test recipients. The MCP server enforces this in all modes.
AEGISVAULT_GMAIL_RECIPIENT_ALLOWLIST=second-test-account@example.com

# Phase 2 must remain dry-run. Do not change without explicit approval.
AEGISVAULT_GMAIL_DRY_RUN=true

# Local runtime settings.
AEGISVAULT_GMAIL_AGENT_MODEL=qwen3:4b-instruct
AEGISVAULT_GMAIL_OLLAMA_URL=http://localhost:11434
AEGISVAULT_GMAIL_OLLAMA_TIMEOUT_SECONDS=600
AEGISVAULT_GMAIL_POLICY=mcp/gmail/policy.yaml
AEGISVAULT_GMAIL_AUDIT_LOG=logs/gmail_mcp.jsonl

# Protected mode defaults to Redis. Use memory only for isolated smoke tests.
AEGISVAULT_GMAIL_GOAL_BACKEND=redis
AEGISVAULT_REDIS_HOST=localhost
AEGISVAULT_REDIS_PORT=6379
AEGISVAULT_REDIS_DB=0
